{
  "db_path": "output/moneyloop.db",
  "output_dir": "output/issues",
  "currency": "USD",
  "usd_jpy": 150.0,
  "llm": {
    "model": "claude-opus-5",
    "scoring_model": "claude-opus-5",
    "effort": "high",
    "max_tokens": 16000,
    "enable_fallbacks": true
  },
  "curation": {
    "lookback_hours": 48,
    "max_items_per_source": 20,
    "score_batch_size": 20,
    "min_score": 60,
    "items_per_issue": 6
  },
  "delivery": {
    "file": true,
    "webhook_url_env": "MONEYLOOP_WEBHOOK_URL"
  },
  "plans": [
    {"code": "free", "name": "Free", "monthly_usd": 0.0, "paywalled": false},
    {"code": "pro", "name": "Pro", "monthly_usd": 30.0, "paywalled": true},
    {"code": "team", "name": "Team", "monthly_usd": 120.0, "paywalled": true}
  ],
  "niches": [
    {
      "code": "ai-ops",
      "name": "AI運用・自動化ウィークリー",
      "audience": "事業会社でAI導入の意思決定をする責任者",
      "angle": "実務で効く自動化事例と、コスト・リスクの読み解き",
      "sources": [
        {"name": "Anthropic News", "url": "https://www.anthropic.com/news/rss.xml"},
        {"name": "Hacker News Frontpage", "url": "https://hnrss.org/frontpage"}
      ]
    }
  ]
