# 使うものだけ設定すればよい。このファイルを .env にコピーして値を入れる。
# .env は .gitignore 済み（コミットしないこと）。

# --- moneyloop / adsite ---

# Claude API キー（実運用時のみ必要。--dry-run では不要）
ANTHROPIC_API_KEY=

# 配信Webhook（Buttondown / Substack / Zapier / Make などの受け口）
MONEYLOOP_WEBHOOK_URL=

# 決済Webhook署名シークレット（Stripe等から購読イベントを受ける場合）
MONEYLOOP_BILLING_SECRET=

# --- growth（成長ループ） ---

# 非公開リポジトリの読み取りと Issue 起票に使う Fine-grained PAT。
# 必要な権限: contents:read / issues:write
# 未設定でも、公開リポジトリだけを対象に動作する。
GROWTH_TOKEN=

# GROWTH_TOKEN が無いときのフォールバック。GitHub Actions では自動で入る。
GITHUB_TOKEN=
