# 使うものだけ設定すればよい。ファイル名を .env にコピーして値を入れる。
# .env は .gitignore 済み（コミットしないこと）。
# 設定状況は `ailab connectors`、実際に繋がるかは `ailab doctor` で確認できる。

# --- 画像生成 ---
# キーが1つも無くても pollinations（無料・キー不要）で生成できる。
# 登録すると待ち時間が短くなり、透かしを外せる: https://auth.pollinations.ai/
POLLINATIONS_TOKEN=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://platform.stability.ai/account/keys
STABILITY_API_KEY=
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Cloudflare Workers AI（無料枠が大きい。2つとも必要）
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# https://huggingface.co/settings/tokens
HF_TOKEN=

# --- 素材取得 (iconify / openverse / wikimedia はキー不要) ---
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# https://unsplash.com/oauth/applications （Access Key のほう）
UNSPLASH_ACCESS_KEY=
# https://www.pexels.com/api/
PEXELS_API_KEY=

# --- 情報収集 (rss はキー不要、qiita はトークン任意) ---
# https://qiita.com/settings/applications （無くても使える。あると枠が広がる）
QIITA_TOKEN=

# Wikipedia の既定の言語 (既定: ja)
# AILAB_WIKIPEDIA_LANG=ja

# --- 送信先 ---
# contents:write 権限のあるトークン https://github.com/settings/tokens
GITHUB_TOKEN=
# ailab publish の既定リポジトリ (owner/name)
AILAB_GITHUB_REPO=

# --- モデルの上書き (任意。各社のモデルIDが変わったとき用) ---
# AILAB_OPENAI_MODEL=gpt-image-2
# AILAB_GEMINI_MODEL=gemini-2.5-flash-image
# AILAB_REPLICATE_MODEL=black-forest-labs/flux-schnell
# AILAB_HUGGINGFACE_MODEL=black-forest-labs/FLUX.1-schnell
# AILAB_STABILITY_MODEL=core
# AILAB_POLLINATIONS_MODEL=flux
# AILAB_CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-1-schnell

# --- 動作設定 (任意) ---
# 出力先 (既定: output)
# AILAB_OUTPUT_DIR=output
# 検索結果キャッシュの保持秒数 (既定: 900、0 で無効)
# AILAB_CACHE_TTL=900
# 利用量の記録にプロンプトを残さない場合は 0
# AILAB_USAGE_PROMPTS=1
# キャッシュ置き場 (既定: ~/.cache/ailab)
# AILAB_CACHE_DIR=
# Hugging Face の推論エンドポイント (提供形態が変わったとき用)
# HF_INFERENCE_URL=https://api-inference.huggingface.co
