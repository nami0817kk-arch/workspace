# 使うものだけ設定すればよい。ファイル名を .env にコピーして値を入れる。
# .env は .gitignore 済み（コミットしないこと）。
# 設定状況は `ailab connectors`、実際に繋がるかは `ailab doctor` で確認できる。

# --- 画像生成 (どれか1つあれば OK。無くても local コネクタは動く) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://platform.stability.ai/account/keys
STABILITY_API_KEY=

# --- 素材取得 (openverse / wikimedia はキー不要) ---
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# --- 送信先 ---
# contents:write 権限のあるトークン https://github.com/settings/tokens
GITHUB_TOKEN=
# ailab publish の既定リポジトリ (owner/name)
AILAB_GITHUB_REPO=

# --- 動作設定 (任意) ---
# 出力先 (既定: output)
# AILAB_OUTPUT_DIR=output
# 検索結果キャッシュの保持秒数 (既定: 900、0 で無効)
# AILAB_CACHE_TTL=900
# キャッシュ置き場 (既定: ~/.cache/ailab)
# AILAB_CACHE_DIR=
