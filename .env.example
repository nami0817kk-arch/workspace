# 使うものだけ設定すればよい。ファイル名を .env にコピーして値を入れる。
# .env は .gitignore 済み（コミットしないこと）。

# --- 画像生成 (どれか1つあれば OK。無くても local プロバイダは動く) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://platform.stability.ai/account/keys
STABILITY_API_KEY=

# --- フリー素材検索 (openverse / wikimedia はキー不要) ---
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# 出力先を変えたい場合のみ
# AILAB_OUTPUT_DIR=output
