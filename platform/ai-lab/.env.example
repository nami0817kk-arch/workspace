# 使うものだけ設定すればよい。このファイルを .env にコピーして値を入れる。
# .env は .gitignore 済み（コミットしないこと）。

# --- moneyloop / adsite ---

# Claude API キー（実運用時のみ必要。--dry-run では不要）
ANTHROPIC_API_KEY=

# 配信Webhook（Buttondown / Substack / Zapier / Make などの受け口）
MONEYLOOP_WEBHOOK_URL=

# 決済Webhook署名シークレット（Stripe等から購読イベントを受ける場合）
MONEYLOOP_BILLING_SECRET=

# --- growth（成長ループ） ---

# 非公開リポジトリの読み取りと Issue 起票に使う Fine-grained PAT。
# 必要な権限: contents:read / issues:write
# 未設定でも、公開リポジトリだけを対象に動作する。
GROWTH_TOKEN=

# GROWTH_TOKEN が無いときのフォールバック。GitHub Actions では自動で入る。
GITHUB_TOKEN=

# --- imagegen（画像生成・素材取得・連携） ---
# 設定状況は `imagegen connectors`、実際に繋がるかは `imagegen doctor` で確認できる。

# 画像生成
# キーが1つも無くても pollinations（無料・キー不要）で生成できる。
# 登録すると待ち時間が短くなり、透かしを外せる: https://auth.pollinations.ai/
POLLINATIONS_TOKEN=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://platform.stability.ai/account/keys
STABILITY_API_KEY=
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Cloudflare Workers AI（無料枠が大きい。2つとも必要）
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# https://huggingface.co/settings/tokens
HF_TOKEN=

# 音声合成（読み上げ）
# キーが1つも無くても、手元で VOICEVOX ENGINE を起動していれば無料で読み上げられる。
# それも無い場合は beep（尺だけ合わせたプレースホルダ音声）になる。
# VOICEVOX ENGINE の場所 (既定: http://127.0.0.1:50021)
# VOICEVOX_URL=http://127.0.0.1:50021
# 既定の話者ID (一覧: imagegen voices --provider voicevox)
# VOICEVOX_SPEAKER=3
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# 既定で使う声 (未設定ならアカウントの先頭の声。一覧: imagegen voices --provider elevenlabs)
# ELEVENLABS_VOICE_ID=
# OpenAI の読み上げは上の OPENAI_API_KEY を共用する

# 素材取得 (iconify / openverse / wikimedia はキー不要)
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# https://unsplash.com/oauth/applications （Access Key のほう）
UNSPLASH_ACCESS_KEY=
# https://www.pexels.com/api/
PEXELS_API_KEY=

# 一次情報（官公庁の公式API。どちらも無料だが登録が要る）
# EDINET: 有価証券報告書・四半期報告書・大量保有報告書などの提出書類
# https://api.edinet-fsa.go.jp/api/auth/index.html
EDINET_API_KEY=
# e-Stat: 政府統計の統計表
# https://www.e-stat.go.jp/api/
ESTAT_APP_ID=

# 情報収集 (rss はキー不要、qiita はトークン任意)
# https://qiita.com/settings/applications （無くても使える。あると枠が広がる）
QIITA_TOKEN=

# Wikipedia の既定の言語 (既定: ja)
# IMAGEGEN_WIKIPEDIA_LANG=ja

# 送信先
# 送信には contents:write 権限のあるトークンが要る（上の GITHUB_TOKEN を共用）
# https://github.com/settings/tokens
# imagegen publish の既定リポジトリ (owner/name)
IMAGEGEN_GITHUB_REPO=

# モデルの上書き (任意。各社のモデルIDが変わったとき用)
# IMAGEGEN_OPENAI_MODEL=gpt-image-2
# IMAGEGEN_GEMINI_MODEL=gemini-2.5-flash-image
# IMAGEGEN_REPLICATE_MODEL=black-forest-labs/flux-schnell
# IMAGEGEN_HUGGINGFACE_MODEL=black-forest-labs/FLUX.1-schnell
# IMAGEGEN_STABILITY_MODEL=core
# IMAGEGEN_POLLINATIONS_MODEL=sana
# IMAGEGEN_CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-1-schnell
# IMAGEGEN_OPENAI_TTS_MODEL=gpt-4o-mini-tts
# IMAGEGEN_ELEVENLABS_MODEL=eleven_multilingual_v2

# 動作設定 (任意)
# 出力先 (既定: output)
# IMAGEGEN_OUTPUT_DIR=output
# 検索結果キャッシュの保持秒数 (既定: 900、0 で無効)
# IMAGEGEN_CACHE_TTL=900
# 利用量の記録にプロンプトを残さない場合は 0
# IMAGEGEN_USAGE_PROMPTS=1
# beep（プレースホルダ音声）の読み上げ速度。1秒あたりの文字数 (既定: 7.0)
# IMAGEGEN_BEEP_CPS=7.0
# キャッシュ置き場 (既定: ~/.cache/imagegen)
# IMAGEGEN_CACHE_DIR=
# Hugging Face の推論エンドポイント (提供形態が変わったとき用)
# HF_INFERENCE_URL=https://api-inference.huggingface.co
