# Claude API キー（https://console.anthropic.com/ で取得）
ANTHROPIC_API_KEY=your_api_key_here

# 使用モデル（未指定なら claude-opus-5）
#   claude-opus-5     入力 $5  / 出力 $25  per 1M トークン（既定・品質重視）
#   claude-sonnet-5   入力 $2  / 出力 $10  per 1M トークン（原価を約6割に）
#   claude-haiku-4-5  入力 $1  / 出力 $5   per 1M トークン（単純作業向け）
# CLAUDE_MODEL=claude-opus-5

# 原価を円換算するレート（未指定なら 155）
# USD_JPY=155
