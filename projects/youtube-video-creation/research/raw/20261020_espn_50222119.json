port": "Soccer"}, "tracking": {"coverageType": "PressConference", "leagueName": "English Premier League", "program": "ESPN", "sportName": "soccer", "trackingId": "dm_261019_Nicol_James_Maddison_will_be_key_for_Tottenham_this_season", "trackingName": "COM_SOC_PRESS CONFERENCE_(Nicol: James Maddison will be key for Tottenham this season)"}}], "categories": [{"id": 81497, "type": "league", "uid": "s:600", "guid": "119cfa41-71d4-39bf-a790-6273a52b0259", "description": "Soccer", "sportId": 600, "leagueId": 600, "league": {"id": 600, "description": "Soccer", "links": {"mobile": {"leagues": {"href": "https://www.espn.com/soccer/"}}, "web": {"leagues": {"href": "https://www.espn.com/soccer/"}}}}}, {"id": 142303, "type": "team", "uid": "s:600~t:367", "guid": "f987a4b2-f3f9-e7f6-eb7d-eda43893be5a", "description": "Tottenham Hotspur", "sportId": 600, "teamId": 367, "team": {"id": 367, "description": "Tottenham Hotspur", "abbreviation": "TOT", "shortDisplayName": "Spurs", "links": {"mobile": {"teams": {"href": "https://www.espn.com/soccer/club/_/id/367/tottenham-hotspur"}}, "web": {"teams": {"href": "https://www.espn.com/soccer/club/_/id/367/tottenham-hotspur"}}}}}, {"id": 137781, "type": "league", "uid": "s:600~l:700", "guid": "6949f3af-300c-35f1-beab-b95669eedd38", "description": "English Premier League", "sportId": 600, "leagueId": 23, "league": {"id": 700, "description": "English Premier League", "abbreviation": "Premier League", "links": {"mobile": {"leagues": {"href": "https://www.espn.com/soccer/league/_/name/eng.1"}}, "web": {"leagues": {"href": "https://www.espn.com/soccer/league/_/name/eng.1"}}}}}, {"id": 244936, "type": "athlete", "uid": "s:600~a:194450", "guid": "4fe4b7b1-afc6-0e2b-332e-74758bd43ce7", "description": "James Maddison", "sportId": 600, "athleteId": 194450, "athlete": {"id": 194450, "description": "James Maddison", "links": {"mobile": {"athletes": {"href": "https://www.espn.com/soccer/player/_/id/194450/james-maddison"}}, "web": {"athletes": {"href": "https://www.espn.com/soccer/player/_/id/194450/james-maddison"}}}}}, {"id": 239980, "type": "athlete", "uid": "s:600~a:272695", "guid": "7dcf567a-7e7a-5125-93b4-ae8cab6ccec4", "description": "Dejan Kulusevski", "sportId": 600, "athleteId": 272695, "athlete": {"id": 272695, "description": "Dejan Kulusevski", "links": {"mobile": {"athletes": {"href": "https://www.espn.com/soccer/player/_/id/272695/dejan-kulusevski"}}, "web": {"athletes": {"href": "https://www.espn.com/soccer/player/_/id/272695/dejan-kulusevski"}}}}}], "keywords": ["Soccer", "Tottenham Hotspur", "English Premier League", "James Maddison", "Dejan Kulusevski"], "story": "<p>An emotional <a data-player-guid=\"4fe4b7b1-afc6-0e2b-332e-74758bd43ce7\" href=\"http://espn.com/soccer/player/_/id/194450/james-maddison\">James Maddison</a> said it was like a \"dream\" to produce a goal and help <a data-clubhouse-guid=\"f987a4b2-f3f9-e7f6-eb7d-eda43893be5a\" href=\"http://espn.com/soccer/team?id=367\">Tottenham</a> climb off the bottom of the <a data-league-guid=\"6949f3af-300c-35f1-beab-b95669eedd38\" href=\"https://www.espn.com/soccer/league/_/name/ENG.1\">Premier League</a> with a 3-1 home win -- their first of the season in the league -- over <a data-clubhouse-guid=\"05650a8f-d953-4acc-dd85-260d59aa4c8f\" href=\"http://espn.com/soccer/team?id=388\">Coventry City</a> on Monday.</p>\n<p>Maddison marked his first start in 526 days after back-to-back knee injuries with a special strike in the 14th minute after he sent a first-time effort over <a data-player-guid=\"f5bff9c6-9946-3749-959a-a406c61d3005\" href=\"http://espn.com/soccer/player/_/id/307069/carl-rushworth\">Carl Rushworth</a> before he marked it with a trademark darts celebration.</p>\n<p>Spurs playmaker Maddison was the best player on the pitch during an even first half but Coventry levelled through <a data-player-guid=\"af3d25b8-488d-0207-3ed0-0bb9f5684eb4\" href=\"http://espn.com/soccer/player/_/id/286967/jack-rudoni\">Jack Rudoni</a> only four minutes into the second period, sparking a frantic period.</p>\n<p>Boss Roberto De Zerbi watched <a data-player-guid=\"33062d91-ea24-3261-b931-757219b741a0\" href=\"http://espn.com/soccer/player/_/id/303745/omar-marmoush\">Omar Marmoush</a> fire Tottenham back in front with 58 minutes played before <a data-player-guid=\"e13a5fa2-8024-2d97-4eae-500af54821fe\" href=\"http://espn.com/soccer/player/_/id/231198/tosin-adarabioyo\">Tosin Adarabioyo</a>, <a data-player-guid=\"2ac3f3cf-816a-d765-a27a-4039ab6d6f13\" href=\"http://espn.com/soccer/player/_/id/104943/andy-robertson\">Andy Robertson</a> and Marmoush were forced off with issues, allowing <a data-player-guid=\"7dcf567a-7e7a-5125-93b4-ae8cab6ccec4\" href=\"http://espn.com/soccer/player/_/id/272695/dejan-kulusevski\">Dejan Kulusevski</a> to make his own comeback after 17 months of injury hell.</p>\n<p>Kulusevski received a special ovation and minutes later <a data-player-guid=\"b3623a17-45fd-b501-97ec-6452ca56f394\" href=\"http://espn.com/soccer/player/_/id/6327/ben-davies\">Ben Davies</a> ensured the Swedish attacker would celebrate his comeback with all three points when Davies' scuffed effort beat Rushworth to earn Spurs an overdue first league victory of the campaign.</p>\n<p>Maddison, who only returned from anterior cruciate ligament damage last April, said after impressing against his hometown club: \"I hoped [to start].</p>\n<p>\"I spoke to the gaffer about it this week and just feeling like the right moment for me to go back into the starting XI after a stop-start start to the season.</p>\n<p>\"I just wanted to play well, show my quality and show what the team's missed in the last 18 months, or whatever it is since my last start.</p>\n<p><photo1></p>\n<p>\"The gaffer asked me to play and said he wanted to enjoy watching me from the side so hopefully I did that. And obviously a goal like that is always nice.\"</p>\n<p>It was Maddison's first goal since his last start -- a 3-1 victory over <a data-clubhouse-guid=\"6f0e42d7-02ff-69bf-7c8d-317c47fcbdbb\" href=\"http://espn.com/soccer/team?id=2980\">Bodo/Glimt</a> in the semifinals of the Europa League at the end of the 2024-25 season.</p>\n<p>\"They're the ones you dream of. Without going too deep into it, them dark days last year, recovering from the ACL, you dream of them moments, them goals and that is the light at the end of the tunnel,\" Maddison told Sky Sports.</p>\n<p>\"That is why I was a bit emotional and I felt really proud of Dejan Kulusevski as well because him coming back.</p>\n<p>\"I knew exactly that feeling of him stepping onto the pitch after that time out, but those moments and goals make it all worth it.\"</p>\n<p>- <a href=\"https://www.espn.co.uk/football/story/_/id/50220042/tottenham-3-1-coventry-james-maddison-goal-dejan-kulusevski-return-brings-feel-good-factor-back-spurshttps://www.espn.co.uk/football/story/_/id/50220042/tottenham-3-1-coventry-james-maddison-goal-dejan-kulusevski-return-brings-feel-good-factor-back-spurs\" target=\"_blank\"><strong>James Maddison goal, Dejan Kulusevski return brings feel-good factor back to Spurs</strong></a><br>\n- <a href=\"https://www.espn.co.uk/football/story/_/id/50217765/dejan-kulusevski-makes-tottenham-return-526-days-suffering-knee-injury\" target=\"_blank\"><strong>Dejan Kulusevski makes Tottenham return 526 days after suffering knee injury</strong></a></p>\n<p>Coventry boss Frank Lampard was frustrated after a strong performance failed to bring any reward.</p>\n<p>\"A really good display. 3-1 changes the view at the end of the game, but I thought at 2-1 we were really pushing,\" Lampard said.</p>\n<p>\"It takes them two outstanding and world-class players to score their goals.</p>\n<p>\"[Tottenham] will get better and improve for sure, but when you think that eight of our starting players were in the Championship...</p>\n<p>\"You wouldn't know which is the team that has been in the Premier League for the last 25 years and who has been out of it.\"</p>\n\n\n\n\n", "allowAMP": true, "allowAds": true, "allowComments": true, "allowCommerce": true, "allowContentReactions": true, "allowSearch": true, "byline": "PA", "isLiveBlog": false, "links": {"api": {"self": {"href": "https://content.core.api.espn.com/v1/sports/news/50222119"}}, "app": {"sportscenter": {"href": "sportscenter://x-callback-url/showStory?uid=50222119"}}, "mobile": {"href": "http://m.espn.go.com/soccer/story?storyId=50222119"}, "web": {"href": "https://www.espn.com/soccer/story/_/id/50222119/maddison-scores-return-spurs-1st-epl-win"}}, "premium": false}], "breakingNews": [], "timestamp": "2026-10-20T00:33:47Z", "status": "success"}