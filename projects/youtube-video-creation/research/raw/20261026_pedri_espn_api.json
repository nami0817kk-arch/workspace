.espn.com/soccer/story/_/id/50282143/jose-mourinho-primes-real-madrid-statement-clasico-win-barcelona-blow-laliga-title-race-wide-open"}},"premium":false},{"id":50246032,"dataSourceIdentifier":"772f3fb190697","publishedkey":"50246032","type":"HeadlineNews","headline":"Kylian Mbappé scores 100th goal for Real Madrid in dramatic Clásico win","title":"Mbappé scores 100th goal for Madrid in dramatic Clásico win","linkText":"Mbappé scores 100th Madrid goal in Clásico win over Barcelona","images":[{"dataSourceIdentifier":"930042840bc3b","id":50280443,"type":"header","name":"Kylian Mbappe [1296x729]","alt":"Kylian Mbappe celebrates.","credit":"(Photo by Lluis GENE / AFP via Getty Images)","height":729,"width":1296,"url":"https://a.espncdn.com/photo/2026/1025/r1736100_1296x729_16-9.jpg"}],"byline":"ESPN","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50246032"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50246032"}},"mobile":{"href":"http://m.espn.go.com/soccer/story?storyId=50246032"},"web":{"href":"https://www.espn.com/soccer/story/_/id/50246032/kylian-mbappe-scores-100th-goal-real-madrid-dramatic-clasico-win"}},"premium":false},{"id":50253144,"dataSourceIdentifier":"99dab14e59d5a","publishedkey":"soccer401882832","type":"Recap","gameId":"401882832","headline":"Mbappé double gives Madrid Clasico win over Barcelona","linkText":"Mbappé double gives Madrid Clasico win over Barcelona","images":[{"dataSourceIdentifier":"d0b45f1ec0f76","id":50280960,"type":"header","name":"Mbappe Madrd celeb vs Barca_261025 [1024x576]","caption":"Real Madrid players celebrate after scoring a goal against Barcelona in LaLiga.","alt":"Real Madrid players celebrate after scoring a goal against Barcelona in LaLiga.","credit":"Getty Images","height":576,"width":1024,"url":"https://a.espncdn.com/photo/2026/1025/r1736144_1024x576_16-9.jpg"}],"byline":"PA","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50253144"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50253144"}},"mobile":{"href":"http://m.espn.go.com/soccer/story?storyId=50253144"},"web":{"href":"http://www.espn.com/soccer/report/_/gameId/401882832"}},"premium":false}],"categories":[{"id":142473,"type":"team","uid":"s:600~t:83","guid":"58f7c4a9-c991-4ed4-fe5c-1f833cba75b8","description":"Barcelona","sportId":600,"teamId":83,"team":{"id":83,"description":"Barcelona","abbreviation":"BAR","shortDisplayName":"Barcelona","links":{"mobile":{"teams":{"href":"https://www.espn.com/soccer/club/_/id/83/barcelona"}},"web":{"teams":{"href":"https://www.espn.com/soccer/club/_/id/83/barcelona"}}}}},{"id":137787,"type":"league","uid":"s:600~l:740","guid":"cf7b0c51-7c48-3e9a-8abb-0c01b1a973a0","description":"Spanish LALIGA","sportId":600,"leagueId":15,"league":{"id":740,"description":"Spanish LALIGA","abbreviation":"LALIGA","links":{"mobile":{"leagues":{"href":"https://www.espn.com/soccer/league/_/name/esp.1"}},"web":{"leagues":{"href":"https://www.espn.com/soccer/league/_/name/esp.1"}}}}},{"id":399368,"type":"athlete","uid":"s:600~a:250465","guid":"3b2df297-82ac-bac8-4727-6551202a0e40","description":"Pedri","sportId":600,"athleteId":250465,"athlete":{"id":250465,"description":"Pedri","links":{"mobile":{"athletes":{"href":"https://www.espn.com/soccer/player/_/id/250465/pedri"}},"web":{"athletes":{"href":"https://www.espn.com/soccer/player/_/id/250465/pedri"}}}}},{"id":81497,"type":"league","uid":"s:600","guid":"119cfa41-71d4-39bf-a790-6273a52b0259","description":"Soccer","sportId":600,"leagueId":600,"league":{"id":600,"description":"Soccer","links":{"mobile":{"leagues":{"href":"https://www.espn.com/soccer/"}},"web":{"leagues":{"href":"https://www.espn.com/soccer/"}}}}},{"id":702227,"type":"contributor","guid":"c17bf901-3bcb-397c-8d65-b11b73233ca5","description":"Sam Marsden","slug":"sam-marsden","contributor":{"id":2911,"description":"Sam Marsden"}}],"keywords":["Barcelona","Spanish LALIGA","Pedri","Soccer","Sam Marsden"],"story":"<p>Midfielder <a data-player-guid=\"3b2df297-82ac-bac8-4727-6551202a0e40\" href=\"http://espn.com/soccer/player/_/id/250465/pedri\">Pedri</a> lamented stupid makes and slowness on the ball as <a data-clubhouse-guid=\"58f7c4a9-c991-4ed4-fe5c-1f833cba75b8\" href=\"http://espn.com/soccer/team?id=83\">Barcelona</a>'s perfect start to the LaLiga season was ended by <a data-clubhouse-guid=\"66434654-a8ba-a04c-98e5-6bbd0dbbb780\" href=\"http://espn.com/soccer/team?id=86\">Real Madrid</a> in the Clásico at Spotify Camp Nou on Sunday.</p>\n<p><a data-player-guid=\"61edbcca-c316-afde-575f-d9dd69176cc4\" href=\"http://espn.com/soccer/player/_/id/231388/kylian-mbappe\">Kylian Mbappé</a> scored twice either side of <a data-player-guid=\"3ab5000b-e423-c068-dd0a-a563ca5ddf90\" href=\"http://espn.com/soccer/player/_/id/231050/raphinha\">Raphinha</a>'s equaliser in the 2-1 win for Jose Mourinho's side, including an 87th-minute goal, as Madrid halted Barça's winning streak in the league at nine games to move within three points of Hansi Flick's team at the top of the table.</p>\n<p><alsosee></p>\n<p>\"In general, we didn't play well,\" Pedri told DAZN. \"We were not ourselves in the first half. There are a lot of things we could have done better.</p>\n<p>\"We got back on level terms in the second half, but we did not defend the second goal well -- from a transition, as well, which we knew they could do.</p>\n<p>\"But, above all, in the first half we were really slow, we lost the ball stupidly a lot and you pay for those mistakes.\"</p>\n<p>Mbappé gave Madrid a first-half lead when he turned home from close range after a poor clearance from <a data-player-guid=\"4004c879-c149-3c51-a23d-75e6a66e664d\" href=\"http://espn.com/soccer/player/_/id/312015/gerard-martin\">Gerard Martín</a>, but Barça fought back after the break through Raphinha's 15th goal of the campaign.</p>\n<p>However, with Barça pushing for a winner late on, they left space in behind which Madrid took advantage of, breaking through with <a data-player-guid=\"73e987f2-c10e-99df-8efd-677706ebab02\" href=\"http://espn.com/soccer/player/_/id/285150/eduardo-camavinga\">Eduardo Camavinga</a>, who teed up Mbappé for his second of the evening and his 100th goal for <em>Los Blancos</em>.</p>\n<p>It completed a miserable week for Barça. After 11 consecutive victories in all competitions, they have now lost back-to-back games after also losing 4-2 at <a data-clubhouse-guid=\"79843c9e-0fe0-63b4-b591-9affc0dbd517\" href=\"http://espn.com/soccer/team?id=160\">Paris Saint-Germain</a> last Tuesday in the Champions League.</p>\n<p><photo caption=\"Pedri attributed Barcelona's loss to Real Madrid to a series of stupid mistakes and giveaways.\"></p>\n<p>Flick refused to label the defeats a \"reality check,\" instead saying tiredness was the reason for the losses.</p>\n<p>\"It's two defeats so of course we are not happy; we are disappointed,\" Flick said in the post-game news conference. \"The first half was not good. The second half, after the equaliser, was better. I think also we controlled the game. We missed a little bit of luck. But they played well, they didn't give us much space.</p>\n<p>\"Also, you could see today we missed the freshness. It's about this. It's the first defeat in LaLiga. We won nine in a row [in the league]. But it happens, defeats are a part of the game.\"</p>\n<p>Flick said the results against PSG and Madrid will \"not create doubts\" around his team, instead doubling down on the fatigue his players are suffering and a defensive injury list which includes <a data-player-guid=\"f9784dd4-93a1-0fe8-630c-c6862fb8d977\" href=\"http://espn.com/soccer/player/_/id/186430/andreas-christensen\">Andreas Christensen</a>, <a data-player-guid=\"f0ebdbb5-289a-5971-6ce2-99bcf1f56dd3\" href=\"http://espn.com/soccer/player/_/id/231692/jules-kounde\">Jules Koundé</a> and <a data-player-guid=\"c79979eb-715d-17bb-6ef9-acd7f2212ad0\" href=\"http://espn.com/soccer/player/_/id/128714/eric-garcia\">Eric García</a> -- and now <a data-player-guid=\"71e0ea17-9f8c-3a67-a99c-101bdcad38d4\" href=\"http://espn.com/soccer/player/_/id/403582/xavi-espart\">Xavi Espart</a>, who was taken off in the first half of the <em>Clásico</em>.</p>\n<p>\"No, no [doubts], that is clear,\" he added. \"Everyone knows the situation, that we don't play very good. But in the big games, small things are important. They decide the games.</p>\n<p>\"We played against an opponent that has huge quality. They were better against the ball than in the <em>Clásico </em>in previous years.</p>\n<p>\"Like I said, you saw today we missed the freshness. After these weeks, it was not easy for my players. We have to now focus again and recover well.</p>\n<p>\"Maybe the most important point is the injuries we have in defence, also Dani [Olmo]. We have to manage it. At the end, in the defence, we had not a lot of options.\"</p>\n<p>Barça remain top of LaLiga, two points clear of Atlético and now just three ahead of Real Madrid. They return to action next Saturday when they host <a data-clubhouse-guid=\"7507af72-2e32-889a-2933-c8254ed82793\" href=\"http://espn.com/soccer/team?id=96\">Alavés</a>.</p>\n\n\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":true,"allowSearch":true,"byline":"Sam Marsden","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50282662"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50282662"}},"mobile":{"href":"http://m.espn.go.com/soccer/story?storyId=50282662"},"web":{"href":"https://www.espn.com/soccer/story/_/id/50282662/pedri-barcelona-stupid-mistakes-loss-real-madrid"}},"premium":false}],"breakingNews":[],"timestamp":"2026-10-26T04:17:58Z","status":"success"}