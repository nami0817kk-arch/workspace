n.com/soccer/league/_/name/esp.1"}},"web":{"leagues":{"href":"https://www.espn.com/soccer/league/_/name/esp.1"}}}}},{"type":"event","uid":"s:600~l:740~e:401882832","guid":"a2bdaa75-6b2c-324e-b5e7-d8a2c2d84687","description":"Real Madrid @ Barcelona","eventId":401882832,"event":{"id":401882832,"sport":"soccer","league":"esp.1","description":"Real Madrid @ Barcelona"}}],"ad":{"bundle":"espnfc","sport":"Soccer"},"tracking":{"coverageType":"Analysis","leagueName":"Spanish LALIGA","program":"ESPN","sportName":"soccer","trackingId":"dm_261025_COM_SOC_Analysis_McManaman3A_Real_MadridE28099s_El_ClC3A1sico_victory_vs_Barcelona_is_good_for_LaLiga_GLOB","trackingName":"COM_SOC Analysis (McManaman: Real Madrid’s El Clásico victory vs. Barcelona is good for LaLiga) GLOBAL 2026-10-25"}}],"categories":[{"id":597349,"type":"topic","guid":"e4d76e8f-6d22-9501-0d34-cdeed991b984","description":"blog - the toe poke","sportId":0,"topicId":65},{"id":142464,"type":"team","uid":"s:600~t:86","guid":"66434654-a8ba-a04c-98e5-6bbd0dbbb780","description":"Real Madrid","sportId":600,"teamId":86,"team":{"id":86,"description":"Real Madrid","abbreviation":"RMA","shortDisplayName":"Real Madrid","links":{"mobile":{"teams":{"href":"https://www.espn.com/soccer/club/_/id/86/real-madrid"}},"web":{"teams":{"href":"https://www.espn.com/soccer/club/_/id/86/real-madrid"}}}}},{"id":137787,"type":"league","uid":"s:600~l:740","guid":"cf7b0c51-7c48-3e9a-8abb-0c01b1a973a0","description":"Spanish LALIGA","sportId":600,"leagueId":15,"league":{"id":740,"description":"Spanish LALIGA","abbreviation":"LALIGA","links":{"mobile":{"leagues":{"href":"https://www.espn.com/soccer/league/_/name/esp.1"}},"web":{"leagues":{"href":"https://www.espn.com/soccer/league/_/name/esp.1"}}}}},{"id":233179,"type":"athlete","uid":"s:600~a:231388","guid":"61edbcca-c316-afde-575f-d9dd69176cc4","description":"Kylian Mbappé","sportId":600,"athleteId":231388,"athlete":{"id":231388,"description":"Kylian Mbappé","links":{"mobile":{"athletes":{"href":"https://www.espn.com/soccer/player/_/id/231388/kylian-mbappe"}},"web":{"athletes":{"href":"https://www.espn.com/soccer/player/_/id/231388/kylian-mbappe"}}}}},{"id":256604,"type":"athlete","uid":"s:600~a:22774","guid":"19e162c0-6bf5-d817-e9f9-81bf96001ee2","description":"Cristiano Ronaldo","sportId":600,"athleteId":22774,"athlete":{"id":22774,"description":"Cristiano Ronaldo","links":{"mobile":{"athletes":{"href":"https://www.espn.com/soccer/player/_/id/22774/cristiano-ronaldo"}},"web":{"athletes":{"href":"https://www.espn.com/soccer/player/_/id/22774/cristiano-ronaldo"}}}}},{"id":81497,"type":"league","uid":"s:600","guid":"119cfa41-71d4-39bf-a790-6273a52b0259","description":"Soccer","sportId":600,"leagueId":600,"league":{"id":600,"description":"Soccer","links":{"mobile":{"leagues":{"href":"https://www.espn.com/soccer/"}},"web":{"leagues":{"href":"https://www.espn.com/soccer/"}}}}}],"keywords":["blog - the toe poke","Real Madrid","Spanish LALIGA","Kylian Mbappé","Cristiano Ronaldo","Soccer"],"story":"\n<p><a data-player-guid=\"61edbcca-c316-afde-575f-d9dd69176cc4\" href=\"http://espn.com/soccer/player/_/id/231388/kylian-mbappe\">Kylian Mbappé</a> reached the 100-goal mark as a <a data-clubhouse-guid=\"66434654-a8ba-a04c-98e5-6bbd0dbbb780\" href=\"http://espn.com/soccer/team?id=86\">Real Madrid</a> player thanks to his two-goal performance in last Sunday's <i>Clásico</i> win over <a data-clubhouse-guid=\"58f7c4a9-c991-4ed4-fe5c-1f833cba75b8\" href=\"http://espn.com/soccer/team?id=83\">Barcelona</a>.</p>\n<p>Mbappé needed just 116 matches to reach 100 goals for <i>Los Blancos</i> and is now the 23rd-highest scorer in the club's history.</p>\n<p>Among the current roster, <a data-player-guid=\"f78d15e9-f696-dc66-52f0-b3f28e6b83e1\" href=\"http://espn.com/soccer/player/_/id/252107/vinicius-junior\">Vinícius Júnior</a> is the top scorer with 128 goals -- ranking 13th of all-time -- followed by Mbappé, <a data-player-guid=\"913dce62-de6b-3d64-93cd-0e85fb3713b0\" href=\"http://espn.com/soccer/player/_/id/267804/rodrygo\">Rodrygo</a> (with 71), and <a data-player-guid=\"5cb69fa5-1b68-f9a2-6a44-ad2447aa4337\" href=\"http://espn.com/soccer/player/_/id/291281/jude-bellingham\">Jude Bellingham</a> (49).</p>\n\n\n<hr>\n\n\n<p><strong>- <a href=\"https://www.espn.com/soccer/story/_/id/50295834/why-real-madrid-kylian-mbappe-barcelona-lamine-yamal-lost-ballon-dor-harry-kane\" target=\"_blank\">Why Mbappé and Yamal didn't deserve to win Ballon d'Or</a><br>\n- <a href=\"https://www.espn.com/soccer/story/_/id/50290210/if-clasico-win-indication-jose-mourinho-real-madrid-just-special-again\" target=\"_blank\">If <em>Clásico</em> is any indication, Mourinho's Madrid might be special again</a><br>\n- <a href=\"https://www.espn.com/soccer/story/_/id/50316200/cristiano-ronaldo-pips-lionel-messi-ballon-dor-all\" target=\"_blank\">Cristiano Ronaldo pips Leo Messi to win 'Ballon d'Or of All Time' prize</a></strong></p>\n\n\n<hr>\n\n\n<p><inline1></p>\n<h2>Eclipsing some Bernabéu greats</h2>\n<p>Mbappé is the 24th player to reach a century of goals for Spain's most successful club and the fifth fastest to do so.</p>\n<p>The 27-year-old is clocking goals at a rate that has him on track to surpass the records of many Real Madrid legends, including Hugo Sánchez and Ronaldo Nazário. Legendary <a href=\"https://www.espn.com/soccer/team/_/id/203\">Mexico</a> forward Sánchez reached 100 goals in 142 games, while <em>O Fenômeno</em> Ronaldo needed 163 appearances.</p>\n<p>Only four Real Madrid greats reached their first 100 goals in fewer games than Mbappé: Ferenc Puskás, <a data-player-guid=\"19e162c0-6bf5-d817-e9f9-81bf96001ee2\" href=\"http://espn.com/soccer/player/_/id/22774/cristiano-ronaldo\">Cristiano Ronaldo</a>, Pahíño, and Alfredo Di Stéfano. Puskás did it in 100 games, Cristiano Ronaldo in 106, Pahíño in 111, and Di Stéfano in 114.</p>\n<p>Cristiano Ronaldo sits top of the Real Madrid scoring charts, slotting in a cool 451 goals in 438 matches before joining <a data-clubhouse-guid=\"87fe4844-a7cf-c88e-2ebe-aeb57325e990\" href=\"http://espn.com/soccer/team?id=111\">Juventus</a>, meaning Mbappé has another 352 goals to score in 322 games if he wants to surpass the <a href=\"https://www.espn.com.au/soccer/team/_/id/482/portugal\" target=\"_blank\">Portugal</a> star.</p>\n<p>That's easy right? Just a goal every 82 minutes!</p>\n<p><inline2></p>\n<h2>Just missing out on the Ballon d'Or</h2>\n<p>Mbappé was the star of the <i>Clásico</i> against Barcelona and capped off his performance by reaching the 100-goal mark.</p>\n<p><inline3></p>\n<p>\"I'm very happy. Everyone knows I like to score goals and help the team that way,\" he told Real Madrid TV. \"But I think today that's just a minor detail, because the most important thing is the team's victory and our success as a group.\"</p>\n<p>However, Mbappé was brought back down to earth on Monday, falling just short in the race for the Ballon d'Or. <a data-player-guid=\"66b16016-7a3a-434f-ae82-e767fc5fac88\" href=\"http://espn.com/soccer/player/_/id/142200/harry-kane\">Harry Kane</a> emerged as the winner at the ceremony, with Mbappé taking second place ahead of <a data-player-guid=\"de67ce6f-0991-36b9-afb9-c008f21dc4b4\" href=\"http://espn.com/soccer/player/_/id/362150/lamine-yamal\">Lamine Yamal</a>.</p>\n<p>Despite being <a href=\"https://www.espn.com.au/soccer/league/_/name/esp.1\" target=\"_blank\">LaLiga</a>'s top scorer in both of his full seasons at the club, the <a data-clubhouse-guid=\"81be996c-0f98-eec4-6284-c6be0d186360\" href=\"http://espn.com/soccer/team?id=478\">France</a> international is yet to win any major trophies with Madrid. That will surely also propel him toward yet another dream of his: winning the Ballon d'Or.</p>\n<p>\"If we want to do things this year, we have to be a group,\" Mbappé said after the Clásico win. \"The quality is here.</p>\n<p>\"With the players here, anyone who says the quality isn't here is a liar. But we have to work as a team, that's how we'll achieve the things we want to.\"</p>\n<p>Mbappé has maintained his remarkably consistent scoring form this season, netting 14 goals in just 13 appearances for Real Madrid so far this term.</p>\n<p>The Frenchman joined Madrid on a free transfer in June 2024 after scoring 256 goals in 308 appearances for <a href=\"https://www.espn.com.au/soccer/team/_/id/160\" target=\"_blank\">Paris Saint-Germain</a>, and 27 in 60 for <a href=\"https://www.espn.com.au/soccer/team/_/id/174\" target=\"_blank\">AS Monaco</a>.</p>\n<p>Mbappé also became France's all-time leading scorer, as well as the top scorer in men's tournament history, after netting 10 times at the <a href=\"https://www.espn.com.au/soccer/worldcup/\" target=\"_blank\">FIFA World Cup</a> in the summer.</p>\n\n\n\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":true,"allowSearch":true,"byline":"Rodra","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50311567"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50311567"}},"mobile":{"href":"http://m.espn.go.com/soccer/story?storyId=50311567"},"web":{"href":"https://www.espn.com/soccer/story/_/id/50311567/mbappes-100-real-madrid-goals-quicker-ronaldo-hit-century"}},"premium":false}],"breakingNews":[],"timestamp":"2026-10-30T00:04:19Z","status":"success"}