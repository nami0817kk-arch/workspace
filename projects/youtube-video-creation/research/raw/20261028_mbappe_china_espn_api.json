s://www.espn.com/soccer/club/_/id/86/real-madrid"}}}}}, {"id": 81497, "type": "league", "uid": "s:600", "guid": "119cfa41-71d4-39bf-a790-6273a52b0259", "description": "Soccer", "sportId": 600, "leagueId": 600, "league": {"id": 600, "description": "Soccer", "links": {"mobile": {"leagues": {"href": "https://www.espn.com/soccer/"}}, "web": {"leagues": {"href": "https://www.espn.com/soccer/"}}}}}, {"id": 137787, "type": "league", "uid": "s:600~l:740", "guid": "cf7b0c51-7c48-3e9a-8abb-0c01b1a973a0", "description": "Spanish LALIGA", "sportId": 600, "leagueId": 15, "league": {"id": 740, "description": "Spanish LALIGA", "abbreviation": "LALIGA", "links": {"mobile": {"leagues": {"href": "https://www.espn.com/soccer/league/_/name/esp.1"}}, "web": {"leagues": {"href": "https://www.espn.com/soccer/league/_/name/esp.1"}}}}}], "ad": {"bundle": "sportscenter", "sport": "Soccer"}, "tracking": {"coverageType": "Final Game Highlight", "leagueName": "Spanish LALIGA", "program": "LALIGA", "sportName": "soccer", "trackingId": "dm_261025_Kylian_Mbappe_double_wins_El_Clasico_for_Real_Madrid", "trackingName": "COM_SOC UK+IRE Highlight (Kylian Mbappé double wins El Clasico for Real Madrid) 2026/10/25"}}], "related": [{"id": 49903623, "dataSourceIdentifier": "f9f20830cc467", "publishedkey": "49903623", "type": "HeadlineNews", "headline": "Kylian Mbappé says viral meme depicting him as dictator 'shows a lack of political awareness in people'", "title": "Kylian Mbappé says viral meme depicting him as dictator 'shows a lack of political awareness in people'", "linkText": "Mbappé criticises meme depicting him as dictator", "images": [{"dataSourceIdentifier": "ae8c60f26a28c", "id": 49903543, "type": "header", "name": "Kylian Mbappe [1296x729]", "alt": "Kylian Mbappe looks on.", "credit": "(Photo by Denis Doyle/Getty Images)", "height": 729, "width": 1296, "url": "https://a.espncdn.com/photo/2026/0911/r1714861_1296x729_16-9.jpg"}], "byline": "Jamie Barton", "isLiveBlog": false, "links": {"api": {"self": {"href": "https://content.core.api.espn.com/v1/sports/news/49903623"}}, "app": {"sportscenter": {"href": "sportscenter://x-callback-url/showStory?uid=49903623"}}, "mobile": {"href": "http://m.espn.go.com/soccer/story?storyId=49903623"}, "web": {"href": "https://www.espn.com/soccer/story/_/id/49903623/kylian-mbappe-dictator-meme-criticises-lack-political-awareness"}}, "premium": false}], "categories": [{"id": 81497, "type": "league", "uid": "s:600", "guid": "119cfa41-71d4-39bf-a790-6273a52b0259", "description": "Soccer", "sportId": 600, "leagueId": 600, "league": {"id": 600, "description": "Soccer", "links": {"mobile": {"leagues": {"href": "https://www.espn.com/soccer/"}}, "web": {"leagues": {"href": "https://www.espn.com/soccer/"}}}}}, {"id": 72584, "type": "team", "uid": "s:600~t:478", "guid": "81be996c-0f98-eec4-6284-c6be0d186360", "description": "France", "sportId": 600, "teamId": 478, "team": {"id": 478, "description": "France", "abbreviation": "FRA", "shortDisplayName": "France", "links": {"mobile": {"teams": {"href": "https://www.espn.com/soccer/team/_/id/478/france"}}, "web": {"teams": {"href": "https://www.espn.com/soccer/team/_/id/478/france"}}}}}, {"id": 142464, "type": "team", "uid": "s:600~t:86", "guid": "66434654-a8ba-a04c-98e5-6bbd0dbbb780", "description": "Real Madrid", "sportId": 600, "teamId": 86, "team": {"id": 86, "description": "Real Madrid", "abbreviation": "RMA", "shortDisplayName": "Real Madrid", "links": {"mobile": {"teams": {"href": "https://www.espn.com/soccer/club/_/id/86/real-madrid"}}, "web": {"teams": {"href": "https://www.espn.com/soccer/club/_/id/86/real-madrid"}}}}}, {"id": 233179, "type": "athlete", "uid": "s:600~a:231388", "guid": "61edbcca-c316-afde-575f-d9dd69176cc4", "description": "Kylian Mbappé", "sportId": 600, "athleteId": 231388, "athlete": {"id": 231388, "description": "Kylian Mbappé", "links": {"mobile": {"athletes": {"href": "https://www.espn.com/soccer/player/_/id/231388/kylian-mbappe"}}, "web": {"athletes": {"href": "https://www.espn.com/soccer/player/_/id/231388/kylian-mbappe"}}}}}, {"id": 137787, "type": "league", "uid": "s:600~l:740", "guid": "cf7b0c51-7c48-3e9a-8abb-0c01b1a973a0", "description": "Spanish LALIGA", "sportId": 600, "leagueId": 15, "league": {"id": 740, "description": "Spanish LALIGA", "abbreviation": "LALIGA", "links": {"mobile": {"leagues": {"href": "https://www.espn.com/soccer/league/_/name/esp.1"}}, "web": {"leagues": {"href": "https://www.espn.com/soccer/league/_/name/esp.1"}}}}}], "keywords": ["Soccer", "France", "Real Madrid", "Kylian Mbappé", "Spanish LALIGA"], "story": "<p><a data-player-guid=\"61edbcca-c316-afde-575f-d9dd69176cc4\" href=\"http://espn.com/soccer/player/_/id/231388/kylian-mbappe\">Kylian Mbappé</a>'s face appears in ads across China, but now at least three companies are cutting ties with the <a data-clubhouse-guid=\"81be996c-0f98-eec4-6284-c6be0d186360\" href=\"http://espn.com/soccer/team?id=478\">France</a> and <a data-clubhouse-guid=\"66434654-a8ba-a04c-98e5-6bbd0dbbb780\" href=\"http://espn.com/soccer/team?id=86\">Real Madrid</a> star after he made some comments apparently referring to Mao Zedong, the founding leader of the People's Republic of China, as a dictator.</p>\n<p>Beverage maker Dongpeng, dairy giant Mengniu and cheese maker Milkground announced Tuesday in similarly worded statements that they were ending agreements with the star, each saying they oppose \"any words and actions that hurt national sentiment.\"</p>\n<p>The companies did not specify what prompted their decisions, but they released their statements after a clip that appeared to show <a href=\"https://www.espn.com/soccer/story/_/id/49903623/kylian-mbappe-dictator-meme-criticises-lack-political-awareness\" target=\"_blank\">Mbappé being interviewed</a> ahead of going on the French online talk show \"The Bridge\" circulated on X.</p>\n<p><photo caption=\"Kylian Mbappé has been dropped by brands in China.\"></p>\n<p>In the video, Mbappé is asked about his favorite meme of himself and replies that it was \"a video someone made of a guy ... I think he was a Chinese dictator\" before the video shows an altered image depicting Mbappé's face on the blue-suited body of Mao Zedong.</p>\n<p>Mbappé issued an apology on Tuesday <a href=\"https://x.com/KMbappe/status/2115045633832931532\" target=\"_blank\">on his social media</a>.</p>\n<p>\"During a recent interview I reacted to an image of myself,\" he said. \"My comment was ill-judged, and I now understand that it hurts many people in China and in Chinese communities around the world. I apologise to everyone my words have upset. This was absolutely not my intention. I have deep respect for the Chinese people and their history and I am sincerely sorry.\"</p>\n<p><alsosee></p>\n<p>Social media platform RedNote joined the criticism, saying in a separate statement that the company had a content partnership with Mbappé that ended on Dec. 31, 2024, and that it would \"remove related promotional materials.\" It likewise expressed opposition to \"any conduct that hurts national sentiment.\"</p>\n<p><strong><a href=\"https://www.espn.co.uk/football/story/_/id/50289067/ballon-dor-2026-results-full-rankings-all-award-winners\">- Ballon d'Or 2026 results: Full rankings, all award winners<br>\n-</a><a href=\"https://www.espn.co.uk/football/story/_/id/50265615/harry-kanes-long-road-ballon-dor-glory-ends-crowning-moment\"> Kane's long road to Ballon d'Or glory ends in crowning moment</a><br>\n<a href=\"https://www.espn.com/soccer/story/_/id/50295834/why-real-madrid-kylian-mbappe-barcelona-lamine-yamal-lost-ballon-dor-harry-kane\" target=\"_blank\">- Why Mbappé and Yamal didn't deserve to win Ballon d'Or</a></strong></p>\n<p>Mbappé has featured in advertising campaigns in China for products from electrolyte drinks to milk and cheese. In one commercial for Dongpeng, Mbappé delivers a slogan in Chinese; in an ad for Mengniu, he appears alongside <a data-player-guid=\"dc5f8d51-332b-0ab2-b4b0-c97efdc624e0\" href=\"http://espn.com/soccer/player/_/id/45843/lionel-messi\">Lionel Messi</a>.</p>\n\n\n<p>On Chinese social media, there were already several comments criticizing him.</p>\n<p>The hashtags \"Dongpeng ends partnership with Mbappé\" and \"Several brands end partnerships with Mbappé\" topped Weibo's trending list. \"Football fans boycott Mbappé\" was also trending, with some users expressing anger at his remarks or telling him not to come to China.</p>\n<p><a data-league-guid=\"cf7b0c51-7c48-3e9a-8abb-0c01b1a973a0\" href=\"https://www.espn.com/soccer/league/_/name/ESP.1\">LaLiga</a> issued a statement on Tuesday distancing themselves from the comments about the meme. </p>\n<p>\"LALIGA deeply regrets the offense caused by Kylian Mbappé's recent comments among Chinese fans,\" <a href=\"https://x.com/LaLigaCorp/status/2115033106138693796?s=20\" target=\"_blank\">the statement said.</a> \"These comments were made in a personal capacity and do not represent LALIGA. To the extent of our institutional responsibility, we apologize on behalf of LALIGA and all its clubs.</p>\n<p>\"Spanish football upholds respect, coexistence, and unity among people of all cultures. We convey our respect to China, its institutions, and its people, and we deeply value the support of the millions of fans who follow us each week. We reaffirm our commitment to a relationship built over years.</p>\n<p>\"We are working with our partners and institutional interlocutors in China to address this situation. Likewise, in collaboration with the clubs and players, we will implement a protocol for awareness and communication that promotes respect for different cultures and helps prevent similar situations.\"</p>\n<p><em>The Associated Press contributed to this report. </em></p>\n\n\n\n\n\n", "allowAMP": true, "allowAds": true, "allowComments": true, "allowCommerce": true, "allowContentReactions": false, "allowSearch": true, "byline": "ESPN News Services", "isLiveBlog": false, "links": {"api": {"self": {"href": "https://content.core.api.espn.com/v1/sports/news/50295111"}}, "app": {"sportscenter": {"href": "sportscenter://x-callback-url/showStory?uid=50295111"}}, "mobile": {"href": "http://m.espn.go.com/soccer/story?storyId=50295111"}, "web": {"href": "https://www.espn.com/soccer/story/_/id/50295111/real-madrid-kylian-mbappe-chinese-brands-dictator-comment"}}, "premium": false}], "breakingNews": [], "timestamp": "2026-10-27T22:41:53Z", "status": "success"}