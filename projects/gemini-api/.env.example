# Google AI Studio (https://aistudio.google.com/apikey) で発行したキー
GEMINI_API_KEY=

# 既定で使うモデル。リクエストごとに上書き可能
GEMINI_MODEL=gemini-3.5-flash

# 生成パラメータの既定値
TEMPERATURE=1.0
MAX_OUTPUT_TOKENS=2048

# 1リクエストの上限秒数（超えたら 504 を返す）
REQUEST_TIMEOUT=60.0

# 一時エラー(429/5xx)時のリトライ回数
MAX_RETRIES=2

# 同一プロンプトのキャッシュ保持秒数（0 で無効）
CACHE_TTL=0

# CORS 許可オリジン（カンマ区切り、* で全許可）
# このゲートウェイを叩く側に要求するキー（カンマ区切りで複数可）。
# 空なら認証なし＝誰でも叩ける。ローカル以外に出すなら必ず設定する。
# 上流に出す GEMINI_API_KEY とは別物。
API_KEYS=

# 1分あたりの許可リクエスト数。0 で無制限。
# X-API-Key 単位（未設定なら接続元IP単位）で数える
RATE_LIMIT_PER_MINUTE=0

# 設定するとキャッシュを Redis に置く（例: redis://localhost:6379/0）。
# 空ならプロセス内メモリ。使うなら `pip install redis` が必要
REDIS_URL=

CORS_ORIGINS=*

LOG_LEVEL=INFO
